{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/features/games/portfolio-formula/source",
    "src/features/games/holdover/source",
    "src/features/games/hoop-legacy/source",
    "tools/hoop-legacy-athletes",
    "src/features/games/vibe-basketball/source",
    "src/features/games/pitch-rush/source",
    "src/features/games/open-golf/source",
    "packages",
    "docs",
    "tools",
    "vendor",
    "src/features/games/*/source"
  ]
}
